import { createUnsavedPictureStore } from '$lib/drawing/unsavedPictureStore';
import { isUnsavedStatus } from '$lib/saveNaming';
import { STORAGE_KEYS, writeBool } from '$lib/storage';
import { fixtureConfig } from './fixture-config';

export function isCurrentHeldPicture(value: unknown): boolean {
  if (typeof value !== 'object' || value === null) return false;
  const record = value as Record<string, unknown>;
  return (
    record.bytes instanceof ArrayBuffer &&
    typeof record.type === 'string' &&
    typeof record.baseName === 'string' &&
    isUnsavedStatus(record.outcome) &&
    (record.signature === null || typeof record.signature === 'string')
  );
}

export async function seedHeld(nonce: string) {
  const binary = atob(fixtureConfig.picture.base64);
  const bytes = Uint8Array.from(binary, (char) => char.charCodeAt(0));
  await createUnsavedPictureStore().write([
    {
      blob: new Blob([bytes], { type: 'image/png' }),
      baseName: `l0-${nonce}`,
      outcome: 'denied',
      signature: `l0-${nonce}`,
    },
  ]);
}

export function falseHeldHint() {
  writeBool(STORAGE_KEYS.unsavedPicturesHeld, false);
}

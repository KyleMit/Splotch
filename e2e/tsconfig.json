{
  // The suite's own TypeScript project, which `npm run check` type-checks (check:e2e): Playwright
  // and Node's type stripping both run these files without checking them. Shaped like
  // netlify/tsconfig.json because the server reaches the /api function's modules through
  // tools/lib/netlify-function-host.d.mts.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vite/client"]
  },
  "include": ["**/*.ts"]
}

{
  "rootManifest": {
    "name": "topology-lock-only-control",
    "private": true,
    "packageManager": "pnpm@11.22.0",
    "dependencies": {
      "topology-lifecycle-control": "file:./control.tgz"
    },
    "scripts": {
      "preinstall": "node root-marker.cjs",
      "install": "node root-marker.cjs",
      "postinstall": "node root-marker.cjs",
      "prepare": "node root-marker.cjs"
    }
  },
  "rootMarkerSource": "require('node:fs').writeFileSync('ROOT_SCRIPT_EXECUTED', 'executed');\n",
  "workspacePolicy": "nodeLinker: hoisted\nstrictDepBuilds: true\nallowBuilds: {}\n",
  "archiveFiles": {
    "package/package.json": "{\"name\": \"topology-lifecycle-control\", \"version\": \"1.0.0\", \"scripts\": {\"postinstall\": \"node marker.cjs\"}}",
    "package/marker.cjs": "require('node:fs').writeFileSync('DEPENDENCY_SCRIPT_EXECUTED', 'executed');\n"
  },
  "archiveBase64": ""
}

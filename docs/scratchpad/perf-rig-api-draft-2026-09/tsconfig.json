{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "paths": {
      "perf-rig": ["./package/types/index.d.ts"],
      "perf-rig/campaign": ["./package/types/campaign.d.ts"],
      "perf-rig/rig": ["./package/types/rig.d.ts"]
    }
  },
  "include": ["package/types/**/*.d.ts", "splotch/**/*.ts"]
}

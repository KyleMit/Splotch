diff --git a/tools/asset-gen/lib/regions.mjs b/tools/asset-gen/lib/regions.mjs
new file mode 100644
index 00000000..a1747965
--- /dev/null
+++ b/tools/asset-gen/lib/regions.mjs
@@ -0,0 +1,32 @@
+export const BG_LIGHT_THRESHOLD = 170;
+
+export function floodBackground(gray, w, h, lightThreshold = BG_LIGHT_THRESHOLD) {
+  const bg = new Uint8Array(w * h);
+  const stack = [];
+  const push = (x, y) => {
+    if (x < 0 || x >= w || y < 0 || y >= h) return;
+    const i = y * w + x;
+    if (!bg[i] && gray[i] > lightThreshold) {
+      bg[i] = 1;
+      stack.push(i);
+    }
+  };
+  for (let x = 0; x < w; x++) {
+    push(x, 0);
+    push(x, h - 1);
+  }
+  for (let y = 0; y < h; y++) {
+    push(0, y);
+    push(w - 1, y);
+  }
+  while (stack.length) {
+    const i = stack.pop();
+    const x = i % w;
+    const y = (i / w) | 0;
+    push(x + 1, y);
+    push(x - 1, y);
+    push(x, y + 1);
+    push(x, y - 1);
+  }
+  return bg;
+}

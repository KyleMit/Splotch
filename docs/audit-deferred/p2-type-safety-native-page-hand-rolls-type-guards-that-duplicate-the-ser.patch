diff --git a/web/src/routes/api/admin/wire.integration.test.ts b/web/src/routes/api/admin/wire.integration.test.ts
new file mode 100644
index 0000000..6494dc6
--- /dev/null
+++ b/web/src/routes/api/admin/wire.integration.test.ts
@@ -0,0 +1,177 @@
+// @vitest-environment node
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+// The wire contract the native console (/admin/native) types its parses
+// against. The handlers build their payloads against TokenSnapshot and
+// LoginResponse, so drift between a type and its producer is a build error;
+// these drive the real handlers so the bytes on the wire are pinned too. Every
+// expectation below is annotated with the wire type, which is what makes the
+// pairing load-bearing: a field added to the type but not emitted (or emitted
+// but not typed) fails here rather than at a shipped native client.
+const { envState } = vi.hoisted(() => ({
+  envState: {} as Record<string, string | undefined>,
+}));
+vi.mock('$env/dynamic/private', () => ({ env: envState }));
+
+// Shape, not persistence — keep the token store off Netlify Blobs. The mock
+// mirrors just enough of $lib/server/tokens to reach both failure reasons: a
+// duplicate is 'invalid', and CAS exhaustion — which the real module only hits
+// under concurrent writes — rides on a sentinel token.
+const { stored } = vi.hoisted(() => ({ stored: { tokens: ['alpha'], persistent: true } }));
+vi.mock('$lib/server/tokens', () => ({
+  getTokensStatus: vi.fn(async () => ({ tokens: stored.tokens, persistent: stored.persistent })),
+  addToken: vi.fn(async (token: string) => {
+    if (token === 'contended') {
+      return { ok: false, error: 'Could not save. Please try again.', reason: 'conflict' };
+    }
+    if (stored.tokens.includes(token)) {
+      return { ok: false, error: 'Token already exists', reason: 'invalid' };
+    }
+    return { ok: true, tokens: [...stored.tokens, token] };
+  }),
+  removeToken: vi.fn(async (token: string) => ({
+    ok: true,
+    tokens: stored.tokens.filter((existing) => existing !== token),
+  })),
+}));
+
+import { sessionToken } from '$lib/server/admin';
+import { POST as login, type LoginResponse } from './login/+server';
+import {
+  GET as listTokens,
+  POST as addToken,
+  DELETE as removeToken,
+  type TokenMutationError,
+  type TokenSnapshot,
+} from './tokens/+server';
+
+const SECRET = 'the-raw-secret';
+const ORIGIN = 'http://localhost';
+
+function signIn(address: string, key: string) {
+  const request = new Request(`${ORIGIN}/api/admin/login`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ key }),
+  });
+  return login({ request, getClientAddress: () => address } as unknown as Parameters<
+    typeof login
+  >[0]);
+}
+
+function callTokens(
+  handler: typeof listTokens,
+  method: string,
+  session: string,
+  body?: { token: string }
+) {
+  const request = new Request(`${ORIGIN}/api/admin/tokens`, {
+    method,
+    headers: {
+      Authorization: `Bearer ${session}`,
+      ...(body ? { 'Content-Type': 'application/json' } : {}),
+    },
+    body: body ? JSON.stringify(body) : undefined,
+  });
+  return handler({ request, url: new URL(request.url) } as unknown as Parameters<
+    typeof listTokens
+  >[0]);
+}
+
+const inviteFor = (token: string) => ({
+  token,
+  url: `${ORIGIN}/?ai_access_token=${encodeURIComponent(token)}`,
+});
+
+beforeEach(() => {
+  envState.ADMIN_ACCESS_TOKEN = SECRET;
+  stored.tokens = ['alpha'];
+  stored.persistent = true;
+});
+
+describe('POST /api/admin/login', () => {
+  it('answers the success arm of LoginResponse', async () => {
+    const response = await signIn('198.51.100.10', SECRET);
+    const expected: LoginResponse = { ok: true, session: sessionToken() };
+
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual(expected);
+  });
+
+  it('answers the failure arm of LoginResponse', async () => {
+    const response = await signIn('198.51.100.11', 'wrong');
+    const expected: LoginResponse = { ok: false, error: 'Incorrect access key.' };
+
+    expect(response.status).toBe(403);
+    expect(await response.json()).toEqual(expected);
+  });
+});
+
+describe('/api/admin/tokens', () => {
+  async function session(address: string) {
+    const body = (await (await signIn(address, SECRET)).json()) as LoginResponse;
+    if (!body.ok) throw new Error('sign-in failed');
+    return body.session;
+  }
+
+  it('answers GET with a TokenSnapshot', async () => {
+    const response = await callTokens(listTokens, 'GET', await session('198.51.100.12'));
+    const expected: TokenSnapshot = {
+      ok: true,
+      tokens: ['alpha'],
+      invites: [inviteFor('alpha')],
+      persistent: true,
+    };
+
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual(expected);
+  });
+
+  // The mutations reuse snapshot(), but they're the responses the client
+  // replaces its whole state from, so each one is pinned separately.
+  it('answers a mutation with the same TokenSnapshot, carrying the new list', async () => {
+    const bearer = await session('198.51.100.13');
+
+    const added = await callTokens(addToken, 'POST', bearer, { token: 'beta' });
+    const afterAdd: TokenSnapshot = {
+      ok: true,
+      tokens: ['alpha', 'beta'],
+      invites: [inviteFor('alpha'), inviteFor('beta')],
+      persistent: true,
+    };
+    expect(await added.json()).toEqual(afterAdd);
+
+    const removed = await callTokens(removeToken, 'DELETE', bearer, { token: 'alpha' });
+    const afterRemove: TokenSnapshot = {
+      ok: true,
+      tokens: [],
+      invites: [],
+      persistent: true,
+    };
+    expect(await removed.json()).toEqual(afterRemove);
+  });
+
+  // The failure arm the native console's `responseError` reads. `reason` is how
+  // the endpoint picks the status; it must not reach the wire, which is what
+  // the TokenMutationError-typed expectation pins.
+  it('answers a rejected mutation with a TokenMutationError and no reason', async () => {
+    const bearer = await session('198.51.100.15');
+
+    const duplicate = await callTokens(addToken, 'POST', bearer, { token: 'alpha' });
+    const invalid: TokenMutationError = { ok: false, error: 'Token already exists' };
+    expect(duplicate.status).toBe(400);
+    expect(await duplicate.json()).toEqual(invalid);
+
+    const contended = await callTokens(addToken, 'POST', bearer, { token: 'contended' });
+    const conflict: TokenMutationError = { ok: false, error: 'Could not save. Please try again.' };
+    expect(contended.status).toBe(409);
+    expect(await contended.json()).toEqual(conflict);
+  });
+
+  it('reports the in-memory fallback through the snapshot', async () => {
+    stored.persistent = false;
+    const response = await callTokens(listTokens, 'GET', await session('198.51.100.14'));
+
+    expect(await response.json()).toMatchObject({ persistent: false });
+  });
+});

diff --git a/scripts/lib/utils.mjs b/scripts/lib/utils.mjs
index a7e06078..3362d94b 100644
--- a/scripts/lib/utils.mjs
+++ b/scripts/lib/utils.mjs
@@ -33,6 +33,18 @@ export function argFlag(name, fallback) {
   return process.argv.find((a) => a.startsWith(prefix))?.slice(prefix.length) ?? fallback;
 }
 
+export function parseFlags(argv, names) {
+  const flags = Object.fromEntries(names.map((name) => [name, false]));
+  const knownNames = new Set(names);
+  const args = [];
+  for (const arg of argv) {
+    const name = arg.startsWith('--') ? arg.slice(2) : '';
+    if (knownNames.has(name)) flags[name] = true;
+    else args.push(arg);
+  }
+  return { ...flags, args };
+}
+
 // Commands go through the shell so PATH shims (npm, npx, gh, sdkmanager)
 // resolve — which means args that aren't plain words need quoting.
 const quoteArg = (arg) => (/^[\w./:=-]+$/.test(arg) ? arg : `"${arg}"`);

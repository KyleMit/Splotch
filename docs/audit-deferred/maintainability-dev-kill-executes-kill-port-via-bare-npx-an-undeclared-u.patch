diff --git a/scripts/dev-kill.mjs b/scripts/dev-kill.mjs
new file mode 100644
index 00000000..ce8d650a
--- /dev/null
+++ b/scripts/dev-kill.mjs
@@ -0,0 +1,56 @@
+import { isMain, runMain, sleep } from './lib/proc.mjs';
+import { freePort } from './lib/vite-server.mjs';
+import { spawnSync } from 'node:child_process';
+import { parseArgs } from 'node:util';
+
+const DEV_PORTS = [5173, 8888];
+const PORT_TERM_GRACE_MS = 1_000;
+const PORT_KILL_GRACE_MS = 1_000;
+const PORT_RECHECK_INTERVAL_MS = 50;
+
+function validatePort(port) {
+  if (!Number.isInteger(port) || port < 1 || port > 65_535) {
+    throw new Error(`Invalid port ${port}: expected an integer from 1 to 65535.`);
+  }
+  return port;
+}
+
+function listenerPids(port) {
+  const result = spawnSync('lsof', ['-ti', `tcp:${port}`, '-sTCP:LISTEN'], { encoding: 'utf8' });
+  if (result.error) throw result.error;
+  return (result.stdout || '')
+    .split('\n')
+    .map((pid) => pid.trim())
+    .filter(Boolean)
+    .map(Number);
+}
+
+async function waitForPortToClear(port, timeoutMs) {
+  const deadline = Date.now() + timeoutMs;
+  for (;;) {
+    const pids = listenerPids(port);
+    if (!pids.length || Date.now() >= deadline) return pids;
+    await sleep(PORT_RECHECK_INTERVAL_MS);
+  }
+}
+
+export async function killDevPorts(ports = DEV_PORTS) {
+  const validatedPorts = ports.map(validatePort);
+  for (const port of validatedPorts) freePort(port);
+  for (const port of validatedPorts) {
+    let pids = await waitForPortToClear(port, PORT_TERM_GRACE_MS);
+    if (!pids.length) continue;
+    for (const pid of pids) {
+      try {
+        process.kill(pid, 'SIGKILL');
+      } catch {}
+    }
+    pids = await waitForPortToClear(port, PORT_KILL_GRACE_MS);
+    if (pids.length) throw new Error(`Port ${port} is still in use after SIGKILL.`);
+  }
+}
+
+if (isMain(import.meta.url)) {
+  const { values } = parseArgs({ options: { port: { type: 'string', multiple: true } } });
+  runMain(() => killDevPorts(values.port?.map(Number)));
+}
diff --git a/scripts/tests/dev-kill.test.mjs b/scripts/tests/dev-kill.test.mjs
new file mode 100644
index 00000000..e75afcc9
--- /dev/null
+++ b/scripts/tests/dev-kill.test.mjs
@@ -0,0 +1,59 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+vi.mock('node:child_process', () => ({ spawnSync: vi.fn() }));
+vi.mock('../lib/vite-server.mjs', () => ({ freePort: vi.fn() }));
+vi.mock('../lib/proc.mjs', async (importOriginal) => {
+  const actual = await importOriginal();
+  return { ...actual, sleep: vi.fn() };
+});
+
+import { spawnSync } from 'node:child_process';
+import { killDevPorts } from '../dev-kill.mjs';
+import { sleep } from '../lib/proc.mjs';
+import { freePort } from '../lib/vite-server.mjs';
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.clearAllMocks();
+  vi.useRealTimers();
+});
+
+describe('killDevPorts', () => {
+  it.each([0, 1.5, 65_536, Number.NaN, 'nope'])(
+    'rejects invalid port %s before cleanup',
+    async (port) => {
+      await expect(killDevPorts([port])).rejects.toThrow('expected an integer from 1 to 65535');
+      expect(freePort).not.toHaveBeenCalled();
+    }
+  );
+
+  it('escalates a listener that survives SIGTERM and verifies that it exits', async () => {
+    vi.useFakeTimers({ now: 0 });
+    sleep.mockImplementation(async () => vi.setSystemTime(1_000));
+    spawnSync
+      .mockReturnValueOnce({ stdout: '123\n' })
+      .mockReturnValueOnce({ stdout: '123\n' })
+      .mockReturnValueOnce({ stdout: '' });
+    const kill = vi.spyOn(process, 'kill').mockImplementation(() => true);
+
+    await killDevPorts([5199]);
+
+    expect(freePort).toHaveBeenCalledWith(5199);
+    expect(kill).toHaveBeenCalledWith(123, 'SIGKILL');
+  });
+
+  it('fails when a listener survives SIGKILL', async () => {
+    vi.useFakeTimers({ now: 0 });
+    sleep.mockImplementation(async () => vi.setSystemTime(Date.now() + 1_000));
+    spawnSync.mockReturnValue({ stdout: '123\n' });
+    vi.spyOn(process, 'kill').mockImplementation(() => true);
+
+    await expect(killDevPorts([5199])).rejects.toThrow('Port 5199 is still in use after SIGKILL.');
+  });
+
+  it('fails when lsof cannot verify that a port is clear', async () => {
+    spawnSync.mockReturnValue({ error: new Error('lsof missing') });
+
+    await expect(killDevPorts([5199])).rejects.toThrow('lsof missing');
+  });
+});

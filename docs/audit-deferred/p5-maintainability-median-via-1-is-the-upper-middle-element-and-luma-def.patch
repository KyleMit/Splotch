diff --git a/tools/asset-gen/lib/stats.mjs b/tools/asset-gen/lib/stats.mjs
index d61bcc3..dfd26a2 100644
--- a/tools/asset-gen/lib/stats.mjs
+++ b/tools/asset-gen/lib/stats.mjs
@@ -1,6 +1,10 @@
 // Shared percentile/median selection for pixel-value arrays (lumas, deltas,
 // stroke widths, channel samples). Sorts a copy so callers can pass arrays
 // they still need untouched.
+//
+// Selects an EXISTING element (index floor(f * (len-1))), never averages —
+// on an even-length input, f=0.5 lands on the LOWER of the two middle
+// elements, not their mean.
 export function quantile(vals, f) {
   const sorted = [...vals].sort((a, b) => a - b);
   return sorted[Math.floor(f * (sorted.length - 1))];
@@ -9,3 +13,9 @@ export function quantile(vals, f) {
 export function median(vals) {
   return quantile(vals, 0.5);
 }
+
+// BT.601 luma, the convention already used by the mask/threshold code across
+// this pipeline (not BT.709 or libvips' internal grayscale weighting).
+export function luma(r, g, b) {
+  return 0.299 * r + 0.587 * g + 0.114 * b;
+}

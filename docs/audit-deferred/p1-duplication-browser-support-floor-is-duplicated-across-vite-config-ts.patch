new file mode 100644
index 00000000..dd0159a3
--- /dev/null
+++ b/web/src/viteConfig.test.ts
@@ -0,0 +1,61 @@
+// @vitest-environment node
+import { readFileSync } from 'node:fs';
+import { describe, expect, it } from 'vitest';
+import viteConfig, { browserslistToViteTargets } from '../vite.config';
+
+const rootPackage = JSON.parse(
+  readFileSync(new URL('../../package.json', import.meta.url), 'utf8')
+) as { browserslist: string[] };
+const xcodeProject = readFileSync(
+  new URL('../../ios/App/App.xcodeproj/project.pbxproj', import.meta.url),
+  'utf8'
+);
+
+function compareVersions(left: string, right: string): number {
+  const leftParts = left.split('.').map(Number);
+  const rightParts = right.split('.').map(Number);
+  for (let index = 0; index < Math.max(leftParts.length, rightParts.length); index += 1) {
+    const difference = (leftParts[index] ?? 0) - (rightParts[index] ?? 0);
+    if (difference !== 0) return difference;
+  }
+  return 0;
+}
+
+describe('Vite browser targets', () => {
+  it('derives the effective Vite targets from the root browserslist', () => {
+    expect(viteConfig.build.target).toEqual(browserslistToViteTargets(rootPackage.browserslist));
+  });
+
+  it('maps only the supported browser-floor syntax', () => {
+    expect(
+      browserslistToViteTargets([
+        'chrome >= 100',
+        'edge >= 101',
+        'firefox >= 102',
+        'safari >= 16.3',
+        'ios_saf >= 16.4',
+      ])
+    ).toEqual(['chrome100', 'edge101', 'firefox102', 'safari16.3', 'ios16.4']);
+    expect(() => browserslistToViteTargets(['last 2 chrome versions'])).toThrow(
+      'Unsupported browserslist entry "last 2 chrome versions"'
+    );
+  });
+
+  it('keeps the Safari and iOS web floors at or below every native iOS target', () => {
+    const webTargets = browserslistToViteTargets(rootPackage.browserslist);
+    const webkitVersions = webTargets
+      .map((target) => target.match(/^(safari|ios)(\d+(?:\.\d+)*)$/))
+      .filter((match) => match !== null);
+    const nativeVersions = [
+      ...xcodeProject.matchAll(/IPHONEOS_DEPLOYMENT_TARGET = (\d+(?:\.\d+)*);/g),
+    ].map((match) => match[1]);
+
+    expect(webkitVersions.map((match) => match[1]).sort()).toEqual(['ios', 'safari']);
+    expect(nativeVersions.length).toBeGreaterThan(0);
+    for (const webkitVersion of webkitVersions.map((match) => match[2])) {
+      for (const nativeVersion of nativeVersions) {
+        expect(compareVersions(webkitVersion, nativeVersion)).toBeLessThanOrEqual(0);
+      }
+    }
+  });
+});

+const ROOT_PACKAGE = JSON.parse(readFileSync('../package.json', 'utf8')) as {
+  version: string;
+  browserslist: string[];
+};
+const PKG_VERSION = ROOT_PACKAGE.version;
 const BUILD_TIME = new Date().toISOString().slice(0, 16).replace('T', ' ');
 
+export function browserslistToViteTargets(entries: string[]): string[] {
+  return entries.map((entry) => {
+    const match = entry.match(/^(chrome|edge|firefox|safari|ios_saf)\s+>=\s+(\d+(?:\.\d+)*)$/);
+    if (!match) {
+      throw new Error(
+        `Unsupported browserslist entry "${entry}". Expected "<browser> >= <version>" for chrome, edge, firefox, safari, or ios_saf.`
+      );
+    }
+    return `${match[1] === 'ios_saf' ? 'ios' : match[1]}${match[2]}`;
+  });
+}

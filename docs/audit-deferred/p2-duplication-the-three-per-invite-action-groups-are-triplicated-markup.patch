+// Below 560px the row's three labelled actions collapse to a single "Copy" plus
+// a "⋯" button opening a modal sheet with the full set. Both layouts are always
+// in the DOM (CSS picks one), so these locate by layout class rather than by
+// accessible name — "Copy code" would otherwise also match the hidden full row.
+const NARROW = { width: 390, height: 800 };
+
+async function addToken(page: Page, token: string) {
+  await page.getByPlaceholder('Add a code…').fill(token);
+  await page.getByRole('button', { name: 'Add code' }).click();
+  await expect(page.getByText(`Added “${token}”`)).toBeVisible();
+}
+
+test('web /admin narrow viewport copies and removes from the ⋯ sheet', async ({
+  page,
+  context,
+  // Deliberately one test rather than two: sign-ins are a budgeted resource
+  // (see the note above signIn), and the flash guard needs the same fixture.
+}) => {
+  await context.grantPermissions(['clipboard-read', 'clipboard-write']);
+  await page.setViewportSize(NARROW);
+  await signIn(page, '/admin');
+
+  const token = `e2e-sheet-${Date.now()}`;
+  await addToken(page, token);
+
+  const row = page.getByRole('listitem').filter({ hasText: token });
+  const compactCopy = row.locator('.invite-actions-compact button').first();
+  const openSheet = row.getByRole('button', { name: `More options for ${token}` });
+  const sheet = page.locator('dialog.more-menu');
+  const items = sheet.locator('.more-menu-item');
+
+  await expect(row.locator('.invite-actions-full')).toBeHidden();
+  await expect(compactCopy).toHaveText('Copy');
+
+  await openSheet.click();
+  await expect(sheet).toBeVisible();
+  await expect(sheet.getByText(token, { exact: true })).toBeVisible();
+  await expect(items).toHaveText(['Copy code', 'Copy link', 'Remove']);
+
+  // Copy link: the sheet closes and the prebuilt invite URL is on the clipboard.
+  await items.nth(1).click();
+  await expect(sheet).toBeHidden();
+  expect(await page.evaluate(() => navigator.clipboard.readText())).toContain(
+    `/?ai_access_token=${token}`
+  );
+
+  // Copy code: same, and the flash lands on the compact row the sheet covered —
+  // the only surface bound to that key at this width.
+  await openSheet.click();
+  await items.nth(0).click();
+  await expect(sheet).toBeHidden();
+  expect(await page.evaluate(() => navigator.clipboard.readText())).toBe(token);
+  await expect(compactCopy).toHaveText('Copied!');
+  await expect(compactCopy).toHaveText('Copy', { timeout: 3000 });
+
+  // `copied` is keyed by token+kind, not by surface, so a sheet item rendering
+  // it would show "Copied!" for a copy the user made on the row behind it. The
+  // sheet is read in one synchronous snapshot alongside the row that must be
+  // flashing: a web-first assertion would just wait out the 1.5s flash and pass
+  // against a real leak, and reading the two separately lets the flash clear in
+  // between. `toPass` retries the whole window if a starved worker misses it.
+  await expect(async () => {
+    if (await sheet.isVisible()) {
+      await page.keyboard.press('Escape');
+      await expect(sheet).toBeHidden();
+    }
+    await compactCopy.click();
+    await openSheet.click();
+    await expect(sheet).toBeVisible();
+
+    const shown = await row.evaluate((rowEl) => ({
+      row: rowEl.querySelector('.invite-actions-compact button')?.textContent?.trim(),
+      title: document.querySelector('.more-menu-title')?.textContent?.trim(),
+      items: Array.from(document.querySelectorAll('.more-menu-item'), (el) =>
+        el.textContent?.trim()
+      ),
+      flashing: document.querySelectorAll('.more-menu-item.copied').length,
+    }));
+
+    // Preconditions: this row's flash is live and the sheet belongs to it, so a
+    // leak would be on screen right now. Retried by toPass if the window closed.
+    expect(shown.row).toBe('Copied!');
+    expect(shown.title).toBe(token);
+
+    expect(shown.items).toEqual(['Copy code', 'Copy link', 'Remove']);
+    expect(shown.flashing).toBe(0);
+  }).toPass({ timeout: 10_000 });
+
+  await page.keyboard.press('Escape');
+  await expect(sheet).toBeHidden();
+  await openSheet.click();
+  await items.nth(2).click();
+  await expect(page.getByText(`Removed “${token}”`)).toBeVisible();
+  await expect(page.getByText(token, { exact: true })).toBeHidden();
+});

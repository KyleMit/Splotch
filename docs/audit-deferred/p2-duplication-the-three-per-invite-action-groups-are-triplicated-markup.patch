+<!-- The same copy/remove actions appear on the full row, the compact row and the
+     more-menu sheet; `inMenu` swaps the button chrome for the sheet's list-item
+     look and dismisses the sheet after the action. The sheet's items never show
+     the "Copied!" flash: dismissing unmounts them before `copy()` resolves, and
+     `copied` is keyed by token+kind rather than by surface, so rendering it here
+     would only ever be another surface's flash leaking in. Copying the code from
+     the sheet flashes the compact row's "Copy" button once the sheet closes;
+     copying the link has no visible feedback at this width, since the only
+     button bound to that key lives in the hidden full-width row. -->
+{#snippet copyAction({
+  invite,
+  kind,
+  label,
+  inMenu = false,
+}: {
+  invite: Invite;
+  kind: 'code' | 'url';
+  label: string;
+  inMenu?: boolean;
+})}
+  {@const key = `${invite.token}:${kind}`}
+  {@const flashed = !inMenu && copied === key}
+  <button
+    type="button"
+    class={inMenu ? 'more-menu-item' : 'btn btn-ghost'}
+    class:copied={flashed}
+    onclick={() => {
+      copy(key, kind === 'code' ? invite.token : invite.url);
+      if (inMenu) closeMenu();
+    }}
+  >
+    {flashed ? 'Copied!' : label}
+  </button>
+{/snippet}
+
+{#snippet removeAction({ invite, inMenu = false }: { invite: Invite; inMenu?: boolean })}
+  <button
+    type="button"
+    class={inMenu ? 'more-menu-item more-menu-item-danger' : 'btn btn-danger'}
+    disabled={busy}
+    aria-label={`Remove ${invite.token}`}
+    onclick={() => {
+      if (inMenu) closeMenu();
+      run(() => onremove(invite.token));
+    }}
+  >
+    Remove
+  </button>
+{/snippet}
+

+describe('Android support floor single source', () => {
+  const SUPPORT_FLOOR_PATTERNS = [
+    [
+      'docs/COMPATIBILITY.md',
+      [
+        /^\| \*\*Native Android app\*\* +\| \*\*Android \d+\.\d+ \/ API (\d+)\+\*\* +\|/m,
+        /^\* \*\*Native Android API (\d+) \(\d+\.\d+\)\*\* is older than the web floor/m,
+        /^\| Native Android min SDK +\| `android\/variables\.gradle` → `minSdkVersion` +\| `(\d+)` +\|$/m,
+      ],
+    ],
+    [
+      '.ruler/skills/mobile/android.md',
+      [
+        /^> Minimum supported OS: \*\*Android \d+\.\d+ \/ API (\d+)\*\* \(`minSdkVersion` in `android\/variables\.gradle`\)\.$/m,
+      ],
+    ],
+    [
+      'web/src/lib/components/androidBeta/androidBeta.ts',
+      [/^export const MIN_ANDROID_API_LEVEL = (\d+);$/m],
+    ],
+  ];
+  const SUPPORT_FLOOR_RELEASE_PATTERNS = [
+    [
+      'docs/COMPATIBILITY.md',
+      [
+        /^\| \*\*Native Android app\*\* +\| \*\*Android (\d+\.\d+) \/ API \d+\+\*\* +\|/m,
+        /^\* \*\*Native Android API \d+ \((\d+\.\d+)\)\*\* is older than the web floor/m,
+      ],
+    ],
+    [
+      '.ruler/skills/mobile/android.md',
+      [
+        /^> Minimum supported OS: \*\*Android (\d+\.\d+) \/ API \d+\*\* \(`minSdkVersion` in `android\/variables\.gradle`\)\.$/m,
+      ],
+    ],
+    [
+      'web/src/lib/components/androidBeta/androidBeta.ts',
+      [/^export const MIN_ANDROID_RELEASE = '(\d+\.\d+)';$/m],
+    ],
+  ];
+
+  for (const [file, patterns] of SUPPORT_FLOOR_PATTERNS) {
+    it(`${file} support floor matches minSdkVersion`, () => {
+      const text = read(file);
+      for (const pattern of patterns) {
+        expect(text.match(pattern)?.[1]).toBe(String(MIN_ANDROID_API_LEVEL));
+      }
+    });
+  }
+
+  for (const [file, patterns] of SUPPORT_FLOOR_RELEASE_PATTERNS) {
+    it(`${file} support floor release matches minSdkVersion`, () => {
+      const text = read(file);
+      for (const pattern of patterns) {
+        expect(text.match(pattern)?.[1]).toBe(MIN_ANDROID_RELEASE);
+      }
+    });
+  }
+});

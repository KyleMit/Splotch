diff --git a/web/src/lib/components/design/Segmented.svelte b/web/src/lib/components/design/Segmented.svelte
new file mode 100644
index 00000000..bef4bd68
--- /dev/null
+++ b/web/src/lib/components/design/Segmented.svelte
@@ -0,0 +1,87 @@
+<script
+  lang="ts"
+  generics="Value extends string, Option extends { value: Value; label: string; id?: string }"
+>
+  import type { Snippet } from 'svelte';
+
+  interface Props {
+    mode: 'radio' | 'toggle';
+    options: Option[];
+    selected: Value | null;
+    label: string;
+    onSelect: (value: Value) => void;
+    content: Snippet<[option: Option]>;
+    class?: string;
+  }
+
+  let { mode, options, selected, label, onSelect, content, class: className }: Props = $props();
+
+  function selectWithArrow(event: KeyboardEvent, index: number) {
+    const offset =
+      event.key === 'ArrowLeft' || event.key === 'ArrowUp'
+        ? -1
+        : event.key === 'ArrowRight' || event.key === 'ArrowDown'
+          ? 1
+          : 0;
+    if (!offset) return;
+
+    event.preventDefault();
+    const nextIndex = (index + offset + options.length) % options.length;
+    onSelect(options[nextIndex].value);
+    (event.currentTarget as HTMLButtonElement).parentElement
+      ?.querySelectorAll<HTMLButtonElement>('.segmented-option')
+      [nextIndex]?.focus();
+  }
+</script>
+
+<div
+  class={['segmented', className]}
+  role={mode === 'radio' ? 'radiogroup' : 'group'}
+  aria-label={label}
+>
+  {#each options as option, index (option.value)}
+    <button
+      type="button"
+      class="segmented-option"
+      class:active={selected === option.value}
+      id={option.id}
+      role={mode === 'radio' ? 'radio' : undefined}
+      aria-checked={mode === 'radio' ? selected === option.value : undefined}
+      aria-pressed={mode === 'toggle' ? selected === option.value : undefined}
+      tabindex={mode === 'radio'
+        ? selected === option.value || (selected === null && index === 0)
+          ? 0
+          : -1
+        : undefined}
+      onclick={() => onSelect(option.value)}
+      onkeydown={mode === 'radio' ? (event) => selectWithArrow(event, index) : undefined}
+    >
+      {@render content(option)}
+    </button>
+  {/each}
+</div>
+
+<style>
+  .segmented {
+    display: flex;
+  }
+
+  .segmented-option {
+    flex: 1;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    gap: var(--space-2);
+    border: none;
+    background: transparent;
+    color: var(--text-mid);
+    font-family: inherit;
+    font-size: var(--font-size-sm);
+    font-weight: var(--font-weight-semibold);
+    cursor: pointer;
+    transition:
+      background var(--duration-fast) ease,
+      color var(--duration-fast) ease,
+      box-shadow var(--duration-fast) ease;
+  }
+</style>

+test.describe('selection rings', () => {
+  test('confirmation animation expands to the resting ring edge', async ({ page }) => {
+    await loadAt(page, 600, 900);
+    const blue = page.getByRole('button', { name: 'Blue' });
+
+    await expect(async () => {
+      await blue.click();
+      await expect(blue).toHaveClass(/active/, { timeout: 1000 });
+      await expect(blue).toHaveClass(/ring-animate/, { timeout: 1000 });
+    }).toPass({ timeout: 10_000 });
+
+    const geometry = await ringGeometry(blue);
+    expect(geometry.flourishAnimation).toBe('swatch-ring-expand');
+    expect(geometry.flourishTop).toBe(-geometry.ringWidth);
+    expect(geometry.flourishBorderWidth).toBe(geometry.ringWidth);
+    expect(geometry.shadowSpreads).toEqual([geometry.seamWidth, geometry.ringWidth]);
+  });
+
+  test('dark-theme seam uses the palette surface color', async ({ page }) => {
+    await page.addInitScript(() => localStorage.setItem('splotch-theme', 'dark'));
+    await loadAt(page, 600, 900);
+    await expect(page.locator('html')).toHaveAttribute('data-theme', 'dark');
+
+    const palette = page.locator('.color-palette');
+    const purple = page.getByRole('button', { name: 'Purple' });
+    const surface = await palette.evaluate((el) => getComputedStyle(el).backgroundColor);
+    const geometry = await ringGeometry(purple);
+
+    expect(geometry.shadowSpreads[0]).toBe(geometry.seamWidth);
+    expect(geometry.boxShadow).toContain(`${surface} 0px 0px 0px ${geometry.seamWidth}px`);
+  });

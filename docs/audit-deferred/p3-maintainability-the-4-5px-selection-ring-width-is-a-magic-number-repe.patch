+async function ringGeometry(swatch: Locator) {
+  return swatch.evaluate((el) => {
+    const style = getComputedStyle(el);
+    const flourish = getComputedStyle(el, '::before');
+    return {
+      ringWidth: Number.parseFloat(style.getPropertyValue('--selection-ring-width')),
+      seamWidth: Number.parseFloat(style.getPropertyValue('--selection-ring-seam')),
+      shadowSpreads: Array.from(style.boxShadow.matchAll(/0px 0px 0px ([\d.]+)px/g), (match) =>
+        Number.parseFloat(match[1])
+      ),
+      boxShadow: style.boxShadow,
+      flourishTop: Number.parseFloat(flourish.top),
+      flourishBorderWidth: Number.parseFloat(flourish.borderTopWidth),
+      flourishAnimation: flourish.animationName,
+    };
+  });
+}
+

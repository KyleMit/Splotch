index 39a245f1..18e6b83a 100644
--- a/web/tests/engine-harness.ts
+++ b/web/tests/engine-harness.ts
@@ -19,6 +19,53 @@ export async function drawStroke(
 export const state = (page: Page) => page.evaluate(() => window.__engineState);
 export const count = (page: Page) => page.evaluate(() => window.__engine.nonTransparentCount());
 
+export async function installCrayonTestkit(page: Page) {
+  await page.evaluate(() => {
+    window.__crayonTestkit = {
+      interpolatePoints(start, end, segments = 40) {
+        const points: { x: number; y: number }[] = [];
+        for (let i = 0; i <= segments; i++) {
+          points.push({
+            x: start.x + ((end.x - start.x) * i) / segments,
+            y: start.y + ((end.y - start.y) * i) / segments,
+          });
+        }
+        return points;
+      },
+      sampleRegion(rect, alphaThreshold) {
+        const canvas = document.getElementById('engineCanvas') as HTMLCanvasElement;
+        const data = canvas
+          .getContext('2d')!
+          .getImageData(rect.x, rect.y, rect.width, rect.height).data;
+        let opaque = 0;
+        let red = 0;
+        let green = 0;
+        let blue = 0;
+        for (let i = 0; i < data.length; i += 4) {
+          if (data[i + 3] > alphaThreshold) {
+            opaque++;
+            red += data[i];
+            green += data[i + 1];
+            blue += data[i + 2];
+          }
+        }
+        return {
+          coverage: opaque / (data.length / 4),
+          rgb: opaque
+            ? [Math.round(red / opaque), Math.round(green / opaque), Math.round(blue / opaque)]
+            : null,
+        };
+      },
+      setupCrayon(color, width) {
+        window.__engine.clearCanvas();
+        window.__engine.setCrayonMode(true);
+        window.__engine.setColor(color);
+        window.__engine.setStrokeWidth(width);
+      },
+    };
+  });
+}

diff --git a/scripts/tests/native-version.test.mjs b/scripts/tests/native-version.test.mjs
new file mode 100644
index 00000000..64c13e43
--- /dev/null
+++ b/scripts/tests/native-version.test.mjs
@@ -0,0 +1,114 @@
+import { describe, expect, it } from 'vitest';
+import { bumpAndroidGradle, bumpIosPbxproj } from '../lib/native-version.mjs';
+
+describe('bumpAndroidGradle', () => {
+  it('updates only the complete primary version assignments', () => {
+    const source = [
+      'android {',
+      '  defaultConfig {',
+      '    // Historical syntax started with /* but was never a block comment',
+      '    versionName "1.2.3" // public version',
+      '    versionCode 12 /* build number */',
+      '    versionNameSuffix ".debug"',
+      '    versionCodeOverride 2',
+      '    // versionName "commented"',
+      '    // versionCode 999',
+      '    /*',
+      '      versionName "9.9.9"',
+      '      versionCode 999',
+      '    */',
+      '    unrelatedVersionName "unchanged"',
+      '  }',
+      '}',
+      '',
+    ].join('\n');
+
+    expect(bumpAndroidGradle(source, '20.0.0', 200)).toBe(
+      [
+        'android {',
+        '  defaultConfig {',
+        '    // Historical syntax started with /* but was never a block comment',
+        '    versionName "20.0.0" // public version',
+        '    versionCode 200 /* build number */',
+        '    versionNameSuffix ".debug"',
+        '    versionCodeOverride 2',
+        '    // versionName "commented"',
+        '    // versionCode 999',
+        '    /*',
+        '      versionName "9.9.9"',
+        '      versionCode 999',
+        '    */',
+        '    unrelatedVersionName "unchanged"',
+        '  }',
+        '}',
+        '',
+      ].join('\n')
+    );
+  });
+
+  it('rejects missing or ambiguous primary assignments with the field-specific error', () => {
+    expect(() => bumpAndroidGradle('  versionCode 1\n', '2.0.0', 20)).toThrow(
+      'Could not find "versionName"'
+    );
+    expect(() =>
+      bumpAndroidGradle(
+        '  versionName "1.0.0"\n  versionName "1.0.1"\n  versionCode 1\n',
+        '2.0.0',
+        20
+      )
+    ).toThrow('Could not find "versionName"');
+    expect(() => bumpAndroidGradle('  versionName "1.0.0"\n', '2.0.0', 20)).toThrow(
+      'Could not find "versionCode"'
+    );
+    expect(() =>
+      bumpAndroidGradle('  versionName "1.0.0"\n  versionCode 1\n  versionCode 2\n', '2.0.0', 20)
+    ).toThrow('Could not find "versionCode"');
+  });
+});
+
+describe('bumpIosPbxproj', () => {
+  it('updates every complete version assignment and leaves substring matches unchanged', () => {
+    const source = [
+      '      MARKETING_VERSION = 1.2.3; /* Debug */',
+      '      CURRENT_PROJECT_VERSION = 12; // Debug build',
+      '      OTHER_SETTING = MARKETING_VERSION = unchanged;',
+      '      // CURRENT_PROJECT_VERSION = 999;',
+      '      // { MARKETING_VERSION = 8.8.8; CURRENT_PROJECT_VERSION = 888; };',
+      '      /*',
+      '        MARKETING_VERSION = 9.9.9;',
+      '        CURRENT_PROJECT_VERSION = 999;',
+      '      */',
+      '        MARKETING_VERSION = 1.2.3; /* Release */',
+      '        CURRENT_PROJECT_VERSION = 12; // Release build',
+      '      buildSettings = { MARKETING_VERSION = 3.4.5; CURRENT_PROJECT_VERSION = 34; };',
+      '',
+    ].join('\n');
+
+    expect(bumpIosPbxproj(source, '20.0.0', 200)).toBe(
+      [
+        '      MARKETING_VERSION = 20.0.0; /* Debug */',
+        '      CURRENT_PROJECT_VERSION = 200; // Debug build',
+        '      OTHER_SETTING = MARKETING_VERSION = unchanged;',
+        '      // CURRENT_PROJECT_VERSION = 999;',
+        '      // { MARKETING_VERSION = 8.8.8; CURRENT_PROJECT_VERSION = 888; };',
+        '      /*',
+        '        MARKETING_VERSION = 9.9.9;',
+        '        CURRENT_PROJECT_VERSION = 999;',
+        '      */',
+        '        MARKETING_VERSION = 20.0.0; /* Release */',
+        '        CURRENT_PROJECT_VERSION = 200; // Release build',
+        '      buildSettings = { MARKETING_VERSION = 20.0.0; CURRENT_PROJECT_VERSION = 200; };',
+        '',
+      ].join('\n')
+    );
+  });
+
+  it('rejects missing complete version assignments', () => {
+    expect(() => bumpIosPbxproj('  CURRENT_PROJECT_VERSION = 1;\n', '2.0.0', 20)).toThrow(
+      'Could not find "MARKETING_VERSION"'
+    );
+    expect(() => bumpIosPbxproj('  MARKETING_VERSION = 1.0.0;\n', '2.0.0', 20)).toThrow(
+      'Could not find "CURRENT_PROJECT_VERSION"'
+    );
+  });
+});

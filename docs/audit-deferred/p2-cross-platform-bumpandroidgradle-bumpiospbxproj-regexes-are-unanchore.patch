 // Bumps the native app version numbers directly in the Android and iOS project
 // files — the two edits the release script used to shell out to the archived
-// `capacitor-set-version` package for (issue #332). The regexes mirror that
-// package's exactly so the produced diffs are byte-identical to before:
+// `capacitor-set-version` package for (issue #332):
 //
 //   Android (android/app/build.gradle, Groovy):
 //     versionName "<x.y.z>"   and   versionCode <n>
@@ -21,35 +20,108 @@ import { join } from 'node:path';
 export const ANDROID_GRADLE_PATH = join('android', 'app', 'build.gradle');
 export const IOS_PBXPROJ_PATH = join('ios', 'App', 'App.xcodeproj', 'project.pbxproj');
 
-// Groovy build.gradle: rewrite the whole `versionName`/`versionCode` lines.
-// `.*` (no newline match) keeps each line's leading indentation and replaces
-// only its value, and the /g flag updates every occurrence — matching the
-// upstream behaviour on files that carry the pair once.
+function maskCommentContents(source) {
+  let result = '';
+  let mode = 'code';
+
+  for (let index = 0; index < source.length; index += 1) {
+    if (mode === 'code' && source.startsWith('//', index)) {
+      result += '//';
+      index += 1;
+      mode = 'line';
+    } else if (mode === 'code' && source.startsWith('/*', index)) {
+      result += '/*';
+      index += 1;
+      mode = 'block';
+    } else if (mode === 'block' && source.startsWith('*/', index)) {
+      result += '*/';
+      index += 1;
+      mode = 'code';
+    } else if (source[index] === '\r' || source[index] === '\n') {
+      result += source[index];
+      if (mode === 'line') {
+        mode = 'code';
+      }
+    } else {
+      result += mode === 'code' ? source[index] : ' ';
+    }
+  }
+
+  return result;
+}
+
+function replaceAssignments(source, replacements) {
+  let result = source;
+  for (const { match, replacement } of replacements.sort(
+    (left, right) => right.match.index - left.match.index
+  )) {
+    const start = match.index;
+    const end = start + match[0].length;
+    const suffixLength = match[2]?.length ?? 0;
+    const suffix = source.slice(end - suffixLength, end);
+    result = `${result.slice(0, start)}${replacement(match[1], suffix)}${result.slice(end)}`;
+  }
+  return result;
+}
+
 export function bumpAndroidGradle(source, version, versionCode) {
-  if (!/versionName.*/.test(source)) {
+  const versionNamePattern =
+    /^([ \t]+)versionName[ \t]+(?:"[^"\r\n]+"|'[^'\r\n]+')([ \t]*(?:(?:\/\/|\/\*).*)?)$/gm;
+  const versionCodePattern = /^([ \t]+)versionCode[ \t]+[0-9]+([ \t]*(?:(?:\/\/|\/\*).*)?)$/gm;
+  const sourceWithoutCommentContents = maskCommentContents(source);
+  const versionNameMatches = [...sourceWithoutCommentContents.matchAll(versionNamePattern)];
+  const versionCodeMatches = [...sourceWithoutCommentContents.matchAll(versionCodePattern)];
+
+  if (versionNameMatches.length !== 1) {
     throw new Error(`Could not find "versionName" in ${ANDROID_GRADLE_PATH}`);
   }
-  if (!/versionCode.*/.test(source)) {
+  if (versionCodeMatches.length !== 1) {
     throw new Error(`Could not find "versionCode" in ${ANDROID_GRADLE_PATH}`);
   }
-  return source
-    .replace(/versionName.*/g, `versionName "${version}"`)
-    .replace(/versionCode.*/g, `versionCode ${versionCode}`);
+  return replaceAssignments(source, [
+    {
+      match: versionNameMatches[0],
+      replacement: (indentation, suffix) => `${indentation}versionName "${version}"${suffix}`,
+    },
+    {
+      match: versionCodeMatches[0],
+      replacement: (indentation, suffix) => `${indentation}versionCode ${versionCode}${suffix}`,
+    },
+  ]);
 }
 
 // Modern Xcode pbxproj: the version/build appear once per build config (Debug +
 // Release), so the /g flag rewrites both. The trailing `;` is part of the
 // pbxproj assignment syntax.
 export function bumpIosPbxproj(source, version, versionCode) {
-  if (!/MARKETING_VERSION = .*/.test(source)) {
+  const marketingVersionPattern =
+    /(?:(?<=^)|(?<=[;{]))([ \t]*)MARKETING_VERSION[ \t]*=[ \t]*[^;\r\n]+;/gm;
+  const projectVersionPattern =
+    /(?:(?<=^)|(?<=[;{]))([ \t]*)CURRENT_PROJECT_VERSION[ \t]*=[ \t]*[^;\r\n]+;/gm;
+  const sourceWithoutCommentContents = maskCommentContents(source);
+  const marketingVersionMatches = [
+    ...sourceWithoutCommentContents.matchAll(marketingVersionPattern),
+  ];
+  const projectVersionMatches = [...sourceWithoutCommentContents.matchAll(projectVersionPattern)];
+
+  if (marketingVersionMatches.length === 0) {
     throw new Error(`Could not find "MARKETING_VERSION" in ${IOS_PBXPROJ_PATH}`);
   }
-  if (!/CURRENT_PROJECT_VERSION = .*/.test(source)) {
+  if (projectVersionMatches.length === 0) {
     throw new Error(`Could not find "CURRENT_PROJECT_VERSION" in ${IOS_PBXPROJ_PATH}`);
   }
-  return source
-    .replace(/(MARKETING_VERSION = ).*/g, `MARKETING_VERSION = ${version};`)
-    .replace(/(CURRENT_PROJECT_VERSION = ).*/g, `CURRENT_PROJECT_VERSION = ${versionCode};`);
+  return replaceAssignments(source, [
+    ...marketingVersionMatches.map((match) => ({
+      match,
+      replacement: (indentation, suffix) =>
+        `${indentation}MARKETING_VERSION = ${version};${suffix}`,
+    })),
+    ...projectVersionMatches.map((match) => ({
+      match,
+      replacement: (indentation, suffix) =>
+        `${indentation}CURRENT_PROJECT_VERSION = ${versionCode};${suffix}`,
+    })),
+  ]);
 }
 

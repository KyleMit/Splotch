new file mode 100644
index 00000000..6b68f424
--- /dev/null
+++ b/tools/asset-gen/tests/gemini.test.mjs
@@ -0,0 +1,99 @@
+import { beforeEach, expect, test, vi } from 'vitest';
+
+const classifyGeminiResponse = vi.hoisted(() => vi.fn());
+const GoogleGenAI = vi.hoisted(() => vi.fn());
+
+vi.mock('../../../web/src/lib/server/ai/geminiSafety.ts', () => ({
+  classifyGeminiResponse,
+}));
+vi.mock('@google/genai', () => ({ GoogleGenAI }));
+
+import { generateImage, IMAGE_MODEL, IMAGE_TIMEOUT_MS, makeClient } from '../lib/gemini.mjs';
+
+const generateContent = vi.fn();
+const ai = { models: { generateContent } };
+
+beforeEach(() => {
+  generateContent.mockReset();
+  classifyGeminiResponse.mockReset();
+  GoogleGenAI.mockReset();
+});
+
+test('constructs the shared Gemini client', () => {
+  expect(makeClient('test-key')).toBeInstanceOf(GoogleGenAI);
+  expect(GoogleGenAI).toHaveBeenCalledWith({ apiKey: 'test-key' });
+});
+
+test('sends an inline image before the prompt and omits undefined options', async () => {
+  const response = {};
+  generateContent.mockResolvedValue(response);
+  classifyGeminiResponse.mockReturnValue({
+    kind: 'image',
+    data: Buffer.from('generated').toString('base64'),
+    mimeType: 'image/png',
+  });
+
+  await expect(
+    generateImage(ai, {
+      imageBytes: Buffer.from('source'),
+      mimeType: 'image/webp',
+      prompt: 'color this',
+    })
+  ).resolves.toEqual({ bytes: Buffer.from('generated'), mimeType: 'image/png' });
+
+  expect(IMAGE_MODEL).toBe('gemini-3.1-flash-image');
+  expect(IMAGE_TIMEOUT_MS).toBe(120_000);
+  expect(generateContent).toHaveBeenCalledWith({
+    model: IMAGE_MODEL,
+    contents: [
+      {
+        role: 'user',
+        parts: [
+          {
+            inlineData: {
+              mimeType: 'image/webp',
+              data: Buffer.from('source').toString('base64'),
+            },
+          },
+          { text: 'color this' },
+        ],
+      },
+    ],
+    config: {
+      abortSignal: expect.any(AbortSignal),
+    },
+  });
+  expect(classifyGeminiResponse).toHaveBeenCalledWith(response);
+});
+
+test('sends text-only generation options with temperature and aspect ratio', async () => {
+  generateContent.mockResolvedValue({});
+  classifyGeminiResponse.mockReturnValue({
+    kind: 'image',
+    data: Buffer.from('outline').toString('base64'),
+    mimeType: 'image/webp',
+  });
+
+  await generateImage(ai, {
+    prompt: 'draw this',
+    temperature: 0,
+    aspectRatio: '2:3',
+  });
+
+  expect(generateContent).toHaveBeenCalledWith({
+    model: IMAGE_MODEL,
+    contents: [{ role: 'user', parts: [{ text: 'draw this' }] }],
+    config: {
+      abortSignal: expect.any(AbortSignal),
+      temperature: 0,
+      imageConfig: { aspectRatio: '2:3' },
+    },
+  });
+});
+
+test('throws the classified kind and reason for a non-image response', async () => {
+  generateContent.mockResolvedValue({});
+  classifyGeminiResponse.mockReturnValue({ kind: 'empty', reason: 'no image part' });
+
+  await expect(generateImage(ai, { prompt: 'draw this' })).rejects.toThrow('empty: no image part');
+});

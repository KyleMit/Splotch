# Claude Code on the web — environment configuration (reference; see docs/CLOUD/Claude.md, ADR-0021).
#
# There is NO official as-code / CLI provisioning for these environments — allowed domains,
# env vars, and the setup script are stateful cloud objects edited only in the web dialog
# (verified against the Claude Code on the web docs, 2026-06). This file is the committed,
# reviewable record of how the environment should be configured; paste from it into the
# dialog. Secret VALUES live only in the dialog and must never be committed.

[allowed-domains]
# Trusted defaults (npm, GitHub, package registries) are implicit. Add:
splotch-tunnel-kyle.fly.dev                     # phone-preview reverse tunnel (ADR-0021)
cdn.playwright.dev                              # E2E browser download
playwright.download.prss.microsoft.com          # E2E browser download
chatgpt.com                                     # Codex plan usage endpoint (run-rival-agent); Full network access needs no entry
auth.openai.com                                 # Codex token refresh (run-rival-agent)

[env]
# Secrets — set the values in the dialog, NEVER commit them.
TUNNEL_AUTH=                                     # chisel shared secret (matches the Fly `AUTH` secret)
OPENAI_API_KEY=                                  # /api/generate-image model calls
ADMIN_ACCESS_TOKEN=                              # /admin console + /api/admin/* auth
ALLOWED_TOKENS_LIST=                             # seed access codes
USAGE_GRANT_ID_SECRET=                           # HMAC key for opaque managed-code usage ids
# Codex ChatGPT-plan login for run-rival-agent: base64 of an auth.json from a DEDICATED login
# (`CODEX_HOME=~/.codex-cloud codex login`), never your working ~/.codex one — see
# docs/CLOUD/Claude.md, "Codex reviews on the ChatGPT plan", for the refresh-rotation shelf life.
CODEX_AUTH_JSON=
# Non-secret — safe to pin here. Lets plain `npm run dev` accept the tunnel host (vite
# allowedHosts). `npm run dev:tunnel` injects this itself, so it's optional if you only
# ever preview via that script.
TUNNEL_HOST=splotch-tunnel-kyle.fly.dev
# Non-secret — how long-running work is bounded; docs/CLOUD/Claude.md, "Bounding long-running
# work", has the mechanisms. There is deliberately no keep-alive setting here: session idle is
# measured on the conversation, not on container activity, so nothing set in this dialog can hold
# a session open while work runs.
#
# The foreground Bash timeout, raised from its stock 120000. A command that outlives it is detached
# rather than killed, and a detached command carries no bound at all — so a longer default is what
# keeps a full test or build run in the foreground, bounded and visible, instead of unbounded.
BASH_DEFAULT_TIMEOUT_MS=600000
# Aborts a background subagent whose model stream has gone dead. It does NOT catch a subagent stuck
# inside a live tool call: tool_heartbeat progress events fire on elapsed time, not on progress, and
# keep resetting it.
CLAUDE_ASYNC_AGENT_STALL_TIMEOUT_MS=300000

[setup-script]
# One-line bootstrap to paste in the dialog; real logic is committed in the target file.
bash .claude/cloud/setup.sh

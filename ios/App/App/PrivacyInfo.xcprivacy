<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Apple's privacy manifest. Without one, uploading the build generates
  ITMS-91053 "Missing API declaration" mail, which blocks the submission before
  App Review sees it.

  This declares the app target. Of the SPM dependencies in
  ios/App/CapApp-SPM/Package.swift, only Capacitor core ships a manifest of its
  own; the plugin packages ship none, so any required-reason API they reach has
  to be declared here.

  NSPrivacyAccessedAPITypes: UserDefaults is the only required-reason API the
  dependency tree touches — @capacitor/preferences writes through
  UserDefaults.standard. (@capacitor-community/media reads PHAsset.creationDate,
  which is Photos asset metadata, not the NSPrivacyAccessedAPICategoryFileTimestamp
  API family, and that code path is Android-only here anyway.) Re-derive this
  list when a plugin is added or upgraded.

  NSPrivacyCollectedDataTypes must stay consistent with the App Store Connect
  nutrition label and with web/src/routes/privacy — see store-assets for the
  declared answers. OtherUserContent covers deliberate AI generation and a
  confirmed AI report. Normal generation and refusals are ephemeral; a confirmed
  report retains its input, resolved prompt, style, and timestamp until the daily
  purge after its 30-day retention date, plus the provider reason for a refusal
  report or the output for a picture report. CustomerSupport covers the private
  feedback form, and OtherDiagnosticData covers its optional device snapshot.
  DeviceID covers the one-way installation pseudonym used for the free allowance,
  and ProductInteraction covers the associated allowance and operational
  generation records. None is linked to identity or used to track.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCustomerSupport</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

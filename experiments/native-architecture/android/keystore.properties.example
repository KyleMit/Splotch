# Copy this file to "keystore.properties" (same folder) and fill in real values.
# keystore.properties is git-ignored; it and the keystore must NEVER be committed.
# Only a store build (-Psplotch.store=true, which the store release script passes) reads it.
# Paths are relative to this android/ folder. The store app keeps the shipping app's
# upload key, so storeFile names the shipping upload keystore.
storeFile=../../../android/upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME

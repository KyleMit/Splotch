{
  "description": "Prepare new Codex worktrees before the first model turn.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tools/bootstrap-worktree.mjs\" --runner=codex",
            "statusMessage": "Preparing the Splotch worktree"
          }
        ]
      }
    ]
  }
}

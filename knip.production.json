{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["dependencies", "unlisted", "unresolved", "binaries"],
  "entry": [
    "netlify/functions/{api,generate-image-background,generation-attempt-background,purge-*}.ts!",
    "tools/netlify-production-install.mjs!",
    "tools/migration/build-native-web.mjs!",
    "tools/migration/check-native-web-precache.mjs!",
    "tools/migration/check-native-web-startup.mjs!",
    "src/index.ts",
    "*.cjs",
    "postcss.config.mjs"
  ],
  "paths": {
    "$lib/*": ["src/lib/*"]
  },
  "ignoreDependencies": [
    "@expo/cli",
    "@expo/metro",
    "@expo/router-server",
    "postcss",
    "postcss-react-strict-dom",
    "prettier"
  ],
  "eslint": false,
  "github-actions": false,
  "playwright": false,
  "prettier": false,
  "stylelint": false,
  "svgo": false,
  "vitest": false
}

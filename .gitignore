## Mac
.DS_Store
build/
# The `build` skill (source + its ruler-generated copies, ADR-0058) must dodge
# the blanket build/ ignore above.
!.ruler/skills/build/
!.claude/skills/build/
!.agents/skills/build/
.netlify/

# Netlify CLI's Deno edge-bundler lockfile — no edge functions in this project, regenerable
deno.lock

# pnpm owns this repo's dependency tree (ADR-0119). `npm run <script>` still works
# against it, but an `npm install` here writes a second lockfile that resolves the
# tree independently of pnpm-lock.yaml and then drifts from it silently. Ignoring
# it means the mistake stays local instead of becoming everyone's; the pair of it
# and pnpm-lock.yaml is what tools/tests/package-manager.test.mjs pins.
package-lock.json

# Opt-in Python tool environments and caches. The only Python project lives under
# tools/centerline-tracing; its pyproject.toml and uv.lock are committed.
.venv/
__pycache__/
.pytest_cache/
/tools/centerline-tracing/benchmark/graphs/
/tools/centerline-tracing/benchmark/out/
/tools/centerline-tracing/benchmark/promoted/
.centerline-tracing-*/

# android studio
android/.idea

# iOS personal signing (DEVELOPMENT_TEAM) — included by ios/debug.xcconfig, passed to ios:archive
ios/local.xcconfig

# Maestro smoke-test screenshots (npm run test:android) — takeScreenshot writes
# these relative to the repo root (Maestro's cwd); keep them out of the tree.
/.maestro/screenshots/

# Red-team AI safety fixtures (ADR-0023). Only encrypted/*.enc is committed;
# the plaintext sources, decrypted copies, and run outputs stay local.
/tools/redteam/source/
/tools/redteam/decrypted/
/tools/redteam/output/

# Image-model eval harness (tools/model-eval/). inputs/ is generated in full by
# npm run model-eval:fixtures — from the coloring assets, the palette, and the
# committed sources in samples/ — so none of it is tracked. The sources are: a
# rerun of the authoring generator draws different art, so the art itself has to
# be kept, and it is kept as traced SVG wherever that beat storing the pixels
# (3-59x smaller, round-trip error under 3/255) and as quantized PNG where it did
# not. Run outputs are large and local; the published reference report lives in
# scrapbook/model-eval/ (ADR-0059).
/tools/model-eval/inputs/
/tools/model-eval/output/
# Scratch dir for ad-hoc eval debugging.
/.eval-tmp/

# Pre-ADR-0108 locations of the two harnesses above, kept ignored so upgrading
# across the tools/ migration cannot expose local data. Git moves tracked files
# only, so a working copy with prior runs keeps its plaintext red-team probes and
# large eval outputs at the old paths — dropping these rules would make them
# untracked-and-visible, i.e. candidates for an accidental `git add -A`, which is
# exactly the ADR-0023 boundary. Safe to delete once no working copy predates the
# migration; nothing writes here anymore.
/web/tests/redteam/source/
/web/tests/redteam/decrypted/
/web/tests/redteam/output/
/web/tests/model-eval/inputs/
/web/tests/model-eval/output/

# Coloring-page fill candidates + overlays generated by tools/asset-gen/coloring/gen-light-fills.mjs
# for review; the shipped colored fills live next to their source pages instead. The generators
# write to the repo root (lib/asset-paths.mjs SAMPLES_DIR/SAMPLES_DARK_DIR); unanchored so ad-hoc
# scratch copies under tools/asset-gen/ stay ignored too.
.coloring-samples/
.coloring-samples-dark/

# Scratch output for the icon-gallery generator (gen:icon-sheet) and other
# scrapbook-page dry runs; promote a keeper into scrapbook/ with scrapbook:publish.
.scrapbook-scratch/

# Checkouts created by worktree-isolated agents (Agent tool `isolation: 'worktree'`).
# They are full copies of the tree, so every file ignored only at its real path reappears at
# a nested path no ignore pattern matches — see .prettierignore, dprint.json, and
# eslint.config.js, which exclude the same directory for that reason.
# ignore-surfaces.test.mjs fails when one of the four drops it.
.claude/worktrees/

# Working state of the scripted audit burndown (npm run audit:burndown, the
# burn-down-audits skill): per-call Claude JSON / Codex JSONL envelopes, run
# log, completed list, schemas, STOP sentinel. Durable state is docs/AUDIT.md + git.
.audit-work/
/tools/gpu-crayon/output/

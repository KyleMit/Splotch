# Worktree-isolated agent checkouts. A nested copy under .claude/worktrees/agent-*/ does not
# match the path-anchored rules below (web/src/tokens.css, the ideas-review.html dashboard),
# so `prettier --check .` fails on files that are correctly ignored at their real location.
# Stated here rather than left to Prettier's .gitignore fallback, which is a CLI default.
.claude/worktrees/
# Committed scrapbook run outputs (ADR-0059) are generated/promoted output, not
# hand-authored source — the index.html and any published HTML/CSS/JS reports
# must not be reformatted. scrapbook/README.md is dprint-owned via *.md below.
scrapbook/
android/
ios/
pnpm-lock.yaml
web/src/lib/components/icon-names.d.ts
web/src/lib/components/page/ReleaseHistory.svelte
web/src/lib/components/settings/CurrentReleaseNotes.svelte
web/src/lib/releases.json
web/src/tokens.css
tools/store-drawings/generated/store-drawings.mjs
web/tests/**/*-snapshots/
*.svg
# Frozen empirical run output; live pipeline configuration remains formatted.
tools/asset-gen/ideas-exploration/**/*.json
# Imported centerline evidence retains the producing Python serializer's stable shape.
tools/centerline-tracing/benchmark/corpus/corpus.json
tools/centerline-tracing/benchmark/metrics.json
tools/centerline-tracing/docs/source-manifest.json
# Frozen review dashboard Prettier cannot round-trip: its reformatted output
# fails its own HTML parser (raw ">" inside <pre> blocks), so formatting it
# would leave the check permanently red.
tools/asset-gen/ideas-exploration/ideas-review.html

# Markdown is owned by dprint (dprint.json, ADR-0057) — permanently out of Prettier scope
*.md

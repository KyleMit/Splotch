# Copy this file to .env (gitignored) to run the app locally against real
# services (npm run dev / dev:netlify).
#
# The E2E suite needs none of it: playwright.shared.ts declares every private
# env var the served app reads — with the outbound-write credentials neutralised
# — and those values win over anything set here.
#
# ALLOWED_TOKENS_LIST is the comma-separated list of managed access tokens
# accepted by /api/generate-image. The value below is a sample, not a real
# secret; Playwright replaces it with the code its throttle spec bursts against.
ALLOWED_TOKENS_LIST="daycare-club"

# Real OpenAI API key — the credential /api/generate-image bills hosted
# generation to, and the only one needed to exercise that flow locally.
# /api/verify-key does not read it: that endpoint checks a key the client
# supplies in the request body (BYOK).
# Playwright replaces it with a key that cannot authenticate, and the specs that
# exercise generation use BYOK (apiKey field) or mock the endpoint.
OPENAI_API_KEY=

# Gemini API key — no longer used by the app. Only the dev-time asset-generation
# pipeline (tools/asset-gen/) and the Gemini baseline rows of the image-model
# bake-off (npm run model-eval) still call it.
GEMINI_API_KEY=

# Admin secret for a real local Netlify server or deployment. Playwright
# deliberately replaces this through commonWebServer with its fixed test credential.
ADMIN_ACCESS_TOKEN=

# In-app feedback → GitHub issue (POST /api/report). GITHUB_ISSUE_TOKEN is a
# fine-grained Personal Access Token scoped to "Issues: Read and write" on the
# target repo only — it is read server-side via $env/dynamic/private and never
# shipped to the client. Without it, /api/report returns a graceful 503 — which
# is the state Playwright and tools/api-smoke/run-local-contract.mjs force, so a token here can
# never file a real issue from a test fixture.
#
# One-time setup:
#   1. Create the token — GitHub → Settings → Developer settings →
#      Fine-grained tokens → Generate new token.
#        - Resource owner: the account/org that owns the repo
#        - Repository access: Only select repositories → KyleMit/splotch-feedback
#        - Permissions: Repository permissions → Issues → Read and write
#          (nothing else)
#      Note the expiry (fine-grained PATs last at most 1 year — rotate before it
#      lapses, or reporting falls back to the 503 above).
#   2. Set it in production — Netlify → Site settings → Environment variables →
#      add GITHUB_ISSUE_TOKEN = <the token>. Redeploy. For local dev, put it in
#      web/.env (gitignored) as below.
#
# GITHUB_ISSUE_REPO overrides the private feedback repo (default: KyleMit/splotch-feedback).
# GITHUB_ISSUE_TOKEN=
# GITHUB_ISSUE_REPO=KyleMit/splotch-feedback

# Signing key for the free tier's picture-report token (POST /api/report-image).
# On a free generation the server mints an HMAC over the installation id and an
# expiry; the report flow spends it. This is what makes the free report path
# server-verifiable — its installation id alone is a client-generated string, so
# without a signed proof that endpoint would be an unauthenticated public write
# to blob storage and the private issue tracker (ADR-0104).
#
# Any high-entropy random string; rotate freely — outstanding tokens expire in
# hours, so rotation only costs an in-flight report. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Set it in production: Netlify → Site settings → Environment variables.
# Unset, BYOK and managed-token reporting still work and the free path alone
# answers 503 (logged server-side).
REPORT_TOKEN_SECRET=

# Passphrase for the red-team AI-safety fixtures (ADR-0023). Encrypts/decrypts
# the crude probe drawings under tools/redteam/ so no viewable PNG of unsafe
# imagery lands in the tree. Share it out-of-band; never commit the real value.
# Used by: npm run redteam:encrypt / redteam:decrypt / redteam.
REDTEAM_FIXTURE_KEY=

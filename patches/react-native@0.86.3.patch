+
+// CSS places a first color stop with no position at 0% and a last one at 100%. Stating those
+// keeps React Native Android's stop parser from logging each null position as an unsupported
+// radius type; the gradient it draws is the same.
+function withEndpointPositions(
+  gradient: ParsedBackgroundImageValue,
+): ParsedBackgroundImageValue {
+  const stops = gradient.colorStops;
+  const last = stops.length - 1;
+  if (last < 0 || (stops[0].position != null && stops[last].position != null)) {
+    return gradient;
+  }
+  return {
+    ...gradient,
+    colorStops: stops.map((stop, index) =>
+      stop.position == null && (index === 0 || index === last)
+        ? {...stop, position: index === 0 ? '0%' : '100%'}
+        : stop,
+    ),
+  };
 }
 
